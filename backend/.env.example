# Comma-separated frontend origins. Add your deployed Vercel URL before launch.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=data/sentinelgate.db

# Optional model-backed prompt scanning. Keep false for the lightweight demo.
ENABLE_HF_CLASSIFIER=false
PROMPT_GUARD_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
PROMPT_GUARD_THRESHOLD=0.80

# Runaway-agent circuit breaker budgets (server-side, enforced; not client-overridable).
# Non-positive or invalid values fall back to the built-in defaults below.
MAX_AGENT_ITERATIONS=5
MAX_TOKEN_BUDGET=2000
